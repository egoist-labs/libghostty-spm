+/// Sets a placeholder IOSurface without validating it against the layer size.
+///
+/// This follows the same main-thread handoff as `setSurface`, but permits the
+/// 1x1 surface used while a terminal is occluded.
+pub inline fn setSurfacePlaceholder(
+    self: *IOSurfaceLayer,
+    surface: *IOSurface,
+) void {
+    surface.retain();
+
+    var block = SetSurfaceBlock.init(.{
+        .layer = self.layer.value,
+        .surface = surface,
+    }, &setSurfacePlaceholderCallback);
+
+    const NSThread = objc.getClass("NSThread").?;
+    if (NSThread.msgSend(bool, "isMainThread", .{})) {
+        setSurfacePlaceholderCallback(&block);
+    } else {
+        macos.dispatch.dispatch_async(
+            @ptrCast(macos.dispatch.queue.getMain()),
+            @ptrCast(&block),
+        );
+    }
+}
+
 const SetSurfaceBlock = objc.Block(struct {
     layer: objc.c.id,
     surface: *IOSurface,
